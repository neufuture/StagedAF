{
  "manifest_version": 3,
  "name": "StagedAF – Virtual Staging for AppFolio",
  "short_name": "StagedAF",
  "version": "0.1.0",
  "description": "Virtually stage property and unit photos in AppFolio: stage new uploads before they go in, or re-stage photos that are already there.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "StagedAF settings" },
  "options_ui": { "page": "src/options.html", "open_in_tab": true },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage", "offscreen", "downloads"],
  "host_permissions": ["https://*.appfolio.com/*", "https://api.openai.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*.appfolio.com/*"],
      "run_at": "document_start",
      "js": [
        "src/shared/defaults.js",
        "src/shared/image.js",
        "src/content/util.js",
        "src/content/ui.js",
        "src/content/stager.js",
        "src/content/appfolio.js",
        "src/content/review.js",
        "src/content/uploads.js",
        "src/content/existing.js",
        "src/content/dock.js",
        "src/content/main.js"
      ]
    },
    {
      "matches": ["https://*.appfolio.com/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["src/content/page-hook.js"]
    }
  ]
}
