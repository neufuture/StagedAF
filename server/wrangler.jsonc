// Cloudflare Worker: serves the website in ./public and the API under /api.
// Secrets (API keys) are NOT set here — add them in the Cloudflare dashboard
// under the Worker's Settings → Variables and Secrets. See docs/SETUP.md.
{
  "name": "unitstager",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Staged photos are kept here for 30 days. Create the bucket once in the
  // Cloudflare dashboard (R2 → Create bucket) with exactly this name.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "unitstager-photos" }],
  // Background staging. Create the queue once (Workers & Pages → Queues →
  // Create) with exactly this name.
  "queues": {
    "producers": [{ "binding": "STAGING_QUEUE", "queue": "unitstager-staging" }],
    "consumers": [{ "queue": "unitstager-staging", "max_batch_size": 1, "max_retries": 3 }]
  },
  // Hourly cleanup (stuck jobs refunded, stagings older than 30 days deleted),
  // and the daily summary email at 15:07 UTC.
  "triggers": { "crons": ["17 * * * *", "7 15 * * *"] },
  // Keep variables added in the Cloudflare dashboard (limits, alert settings)
  // when deploying, instead of resetting them to only what's listed here.
  "keep_vars": true,
  "vars": {
    "SITE_URL": "https://unitstager.com",
    "OPENAI_MODEL": "gpt-image-2",
    "OPENAI_QUALITY": "high",
    "FREE_CREDITS": "10"
  }
}
